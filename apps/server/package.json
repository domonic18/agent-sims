{
  "name": "@sims/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed/index.ts",
    "sim:run": "tsx src/world/sim-run.ts"
  },
  "dependencies": {
    "@sims/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.2.0",
    "postgres": "^3.4.5",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
