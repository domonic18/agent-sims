{
  "name": "@sims/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "prompts"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed/index.ts",
    "sim:run": "tsx src/world/sim-run.ts",
    "assets:import": "tsx --env-file-if-exists=../../.env src/assets/cli.ts import",
    "assets:import-singles": "tsx --env-file-if-exists=../../.env src/assets/cli.ts import-singles",
    "assets:publish": "tsx --env-file-if-exists=../../.env src/assets/cli.ts publish"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-checkpoint": "^1.1.6",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.6",
    "@langchain/langgraph-sdk": "^1.12.3",
    "@langchain/openai": "^1.6.2",
    "@sims/shared": "workspace:*",
    "deepagents": "^1.14.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.2.0",
    "langchain": "^1.5.16",
    "langsmith": "^0.9.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.5",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
