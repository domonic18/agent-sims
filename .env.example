# agent-sims 环境变量样例
# 复制为 .env 后填写真实值;.env 永不入库
# 注意: 模型选型与 API-Key 不在此配置,统一经后台管理维护(requirement §2.6,AES 加密存储)
# 变量与代码的对应关系见 apps/server/src/config/env.ts;部署全流程见 docs/deploy.md

# ---- 运行环境 ----
# development(本地 pnpm dev + dev 库)/ production(docker 生产栈,compose 已默认)
NODE_ENV=development

# ---- 游戏服务 ----
# 服务监听端口(本地直连调试用;生产容器内固定 3100 不对外)
GAME_PORT=3100

# ---- 数据库(Postgres+pgvector)----
# 本地开发连 dev 库(docker/docker-compose.dev.yml 默认账号密码)
DATABASE_URL=postgres://sims:sims@localhost:5432/agent_sims

# ---- 必填(生产安全三件套,部署前务必改掉默认值)----
# 数据库密码: 生产 compose 用它拼接容器内 DATABASE_URL 并注入 postgres 容器;
# 与本地 dev 的 sims/sims 无关。改密码=指向新库,已有数据需随 postgres 卷一并迁移
POSTGRES_PASSWORD=change-me-strong
# Key 加密主密钥(AES 根,不是任何模型 Key;同时签发管理端 token,≥16 位;
# 生产必改,修改后已登录会话与已存模型 Key 解密失效,需重新录入)
MASTER_KEY=change-me-to-a-long-random-string
# 后台管理员初始密码(≥6 位;seed 首启写入 admin_users,之后修改此项无效,
# 请在后台「改密码」入口操作)
ADMIN_INITIAL_PASSWORD=change-me

# ---- 可选(有合理默认,按需覆盖)----
# 对外 web 端口(nginx 单入口,frpc 穿透目标;默认 9000)
#WEB_PORT=9000
# 跨域白名单,逗号分隔(默认空=仅同源;页面与 API 不同域部署时才需要,OPS-2)
#CORS_ORIGINS=
# 管理端会话有效期毫秒(默认 12 小时)
#ADMIN_TOKEN_TTL_MS=43200000
# 模型连通性探测/正式调用超时毫秒(默认 15000/60000,慢思考长输出可上调)
#PROBE_TIMEOUT_MS=15000
#LLM_TIMEOUT_MS=60000
# compose 项目名(生产调用已显式 -p agent-sims,此项仅为免 -p 时兜底)
#COMPOSE_PROJECT_NAME=agent-sims

# ---- 模型配置不在 env ----
# 启动后到 web /admin 登录,在「模型配置」页填写四槽位
# (Base URL 含 /v1、模型名、API Key,仅存 model_configs 表,AES-256-GCM 加密)。
# 验证连通: 页面「测试连通」按钮或 pnpm spike:llm(Spike①)。
