# agent-sims 环境变量样例
# 复制为 .env 后填写真实值;.env 永不入库
# 注意: 模型选型与 API-Key 不在此配置,统一经后台管理维护(requirement §2.6,AES 加密存储)

# 运行环境
NODE_ENV=development

# 游戏服务
GAME_PORT=3100

# 数据库(Postgres+pgvector;docker/docker-compose.dev.yml 默认值)
DATABASE_URL=postgres://sims:sims@localhost:5432/agent_sims

# Key 加密主密钥(AES 根,不是任何模型 Key;生产必改)
MASTER_KEY=change-me-to-a-long-random-string

# 后台管理员初始密码(首次登录后建议修改)
ADMIN_INITIAL_PASSWORD=change-me

# ── Spike① 模型连通性验证(M1 临时;pinky:pnpm spike:llm 触发,M4 后统一走后台配置)──
# BASE_URL 约定含 /v1(如 https://api.openai.com/v1);四槽位填齐所需项即可,留空自动跳过
# SPIKE_SLOW_BASE_URL=
# SPIKE_SLOW_MODEL=
# SPIKE_SLOW_API_KEY=
# SPIKE_LIGHT_BASE_URL=
# SPIKE_LIGHT_MODEL=
# SPIKE_LIGHT_API_KEY=
# Jev 默认 https://api.codiv.ai/v1 + openjev-0.1,仅填 Key 亦可
# SPIKE_JEV_BASE_URL=
# SPIKE_JEV_MODEL=
# SPIKE_JEV_API_KEY=
# SPIKE_EMBEDDING_BASE_URL=
# SPIKE_EMBEDDING_MODEL=
# SPIKE_EMBEDDING_API_KEY=
